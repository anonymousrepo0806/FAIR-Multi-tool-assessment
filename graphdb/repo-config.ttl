# RDF4J/GraphDB repository config, auto-imported on first container start
# (see docker-compose.yml's `graphdb` service: it's mounted into GraphDB's
# workbench import directory, which GraphDB scans and provisions from at
# startup). Defines a single repository, "fair", with GraphDB's plain
# "empty" ruleset -- no RDFS/OWL reasoning, since every score is already
# precomputed before it's written as a triple (see sparql_endpoint.py); this
# repository is a query surface, not an inference engine.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep: <http://www.openrdf.org/config/repository#> .
@prefix sr: <http://www.openrdf.org/config/repository/sail#> .
@prefix sail: <http://www.openrdf.org/config/sail#> .
@prefix graphdb: <http://www.ontotext.com/config/graphdb#> .

[] a rep:Repository ;
    rep:repositoryID "fair" ;
    rdfs:label "FAIR Multi-Assessor corpus" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "graphdb:Sail" ;
            graphdb:ruleset "empty" ;
            graphdb:storage-folder "storage" ;
            graphdb:base-URL "https://fair-multi-assessor.local/schema#" ;
            graphdb:repository-type "file-repository" ;
            graphdb:check-for-inconsistencies "false" ;
            graphdb:disable-sameAs "true" ;
            graphdb:enable-context-index "false" ;
            graphdb:enablePredicateList "true" ;
            graphdb:in-memory-literal-properties "true" ;
            graphdb:enable-literal-index "true" ;
            graphdb:query-timeout "0" ;
            graphdb:read-only "false" ;
        ]
    ] .
