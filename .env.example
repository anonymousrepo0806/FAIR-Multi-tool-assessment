GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Which Gemini model the monthly ingestion job uses to categorize newly
# discovered datasets (is this BLOD/biomedical, or which other corpus
# category?). Defaults to GEMINI_MODEL, or gemini-2.0-flash if that's also
# blank. Uses the same GEMINI_API_KEY above -- no separate key needed.
# Without a key, newly-discovered datasets still get stored, just under a
# generic fallback category instead of an LLM-classified one.
GEMINI_CATEGORIZER_MODEL=

# Credentials for the F-UJI container's own basic-auth API (set in
# fuji/Dockerfile / the F-UJI image itself). The defaults below match the
# F-UJI image's own defaults -- only change these if you've changed them
# on the F-UJI side too.
FUJI_USER=marvel
FUJI_PASSWORD=wonderwoman

# Only set this if you're running your own self-hosted KGHeartBeat
# instance with a REST endpoint (see backend/tools/kgheartbeat_client.py).
# Leave blank to use the built-in real-time URL probing / precomputed
# corpus lookups instead -- this is NOT required for KGHeartBeat to work.
KGHEARTBEAT_API_URL=

# Optional: base URL of KGHeartBeat's public per-dataset fairness API
# (ends in /kgheartbeat-api/fairness). Only used by discovery.py's live lookup.
KGHEARTBEAT_FAIRNESS_URL=

# Comma-separated list of extra origins allowed to call the backend's API
# (CORS). Leave blank for the default same-origin nginx proxy setup --
# only needed if you're hosting the frontend somewhere other than the
# bundled nginx container.
FRONTEND_ORIGINS=

# Optional: point the corpus browser at a real Postgres database instead of
# the CSV files baked into the backend image. Leave blank to keep using the
# CSVs (the default -- fine for the current read-mostly, single-instance
# corpus). Set this once concurrent writers, horizontal scaling across
# backend replicas, or real transactional guarantees are needed. On first
# boot with this set, the backend creates the schema and seeds it from the
# bundled CSVs automatically -- no manual migration step required.
#
# docker-compose.yml already bundles a `postgres` service for this; point
# at it with:
#   DATABASE_URL=postgresql://fair_app:fair_app_pw@postgres:5432/fair_multi_assessor
# (change the password here and in docker-compose.yml's `postgres` service
# before using this anywhere but local/dev). Or point at your own instance.
DATABASE_URL=

# Optional: point the /sparql endpoint at a real triplestore (Ontotext
# GraphDB) instead of the in-memory rdflib graph rebuilt from the corpus on
# demand. Leave blank to keep the in-memory graph (the default -- fine for
# the current single-instance, read-mostly corpus). Set this once SPARQL
# needs concurrent writes, horizontal scaling across backend replicas, or
# querying from outside this app. On first boot with this set, the backend
# seeds the repository with the corpus automatically -- no manual load step.
#
# docker-compose.yml already bundles a `graphdb` service with a "fair"
# repository auto-provisioned from graphdb/repo-config.ttl; point at it with:
#   GRAPHDB_SPARQL_URL=http://graphdb:7200/repositories/fair
# Or point at your own GraphDB instance/repository. GRAPHDB_UPDATE_URL
# defaults to "<GRAPHDB_SPARQL_URL>/statements" (GraphDB's standard RDF4J
# statements endpoint) -- only set it separately if yours differs.
GRAPHDB_SPARQL_URL=
GRAPHDB_UPDATE_URL=
